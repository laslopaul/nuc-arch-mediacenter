services:
  plex:
    image: {{ images['plex'] }}
    container_name: plex
    network_mode: host
    environment:
      - PUID={{ managed_user_uid }}
      - PGID={{ managed_user_gid }}
      - TZ={{ timezone }}
      - VERSION=docker
    volumes:
      - {{ docker_path }}/{{ docker_service_catalog['plex'].directory }}/config:/config
      - {{ media_path }}/Shows:/tv
      - {{ media_path }}/Movies:/movies
    devices:
      - /dev/dri:/dev/dri
    restart: unless-stopped
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.plex.rule=Host(`plex.{{ public_domain }}`)"
      - "traefik.http.routers.plex.entrypoints=websecure"
      - "traefik.http.routers.plex.tls=true"
      - "traefik.http.routers.plex.service=plex"
      - "traefik.http.services.plex.loadbalancer.server.port=32400"
      - "traefik.http.services.plex.loadbalancer.server.scheme=http"
