services:
  jellyfin:
    image: {{ images['jellyfin'] }}
    container_name: jellyfin
    networks:
      - traefik_traefik
    environment:
      - PUID={{ managed_user_uid }}
      - PGID={{ managed_user_gid }}
      - TZ={{ timezone }}
    volumes:
      - {{ docker_path }}/{{ docker_service_catalog['jellyfin'].directory }}/config:/config
      - {{ media_path }}/Shows:/tv:ro
      - {{ media_path }}/Movies:/movies:ro
    devices:
      - /dev/dri:/dev/dri
    restart: unless-stopped
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.jellyfin.rule=Host(`jellyfin.{{ public_domain }}`)"
      - "traefik.http.routers.jellyfin.entrypoints=websecure"
      - "traefik.http.routers.jellyfin.tls=true"
      - "traefik.http.routers.jellyfin.service=jellyfin"
      - "traefik.http.services.jellyfin.loadbalancer.server.port=8096"
      - "traefik.http.services.jellyfin.loadbalancer.server.scheme=http"
      - "traefik.docker.network=traefik_traefik"

networks:
  traefik_traefik:
    external: true
