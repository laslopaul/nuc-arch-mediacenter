[Unit]
Description=Step TLS Renewer for Traefik
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=1
User={{ username }}
Environment=STEPPATH={{ pki_path }}/step
ExecStart=/usr/local/bin/step ca renew --daemon --exec "docker restart traefik" {{ docker_path }}/{{ docker_service_catalog['traefik'].directory }}/ssl/cert.crt {{ docker_path }}/{{ docker_service_catalog['traefik'].directory }}/ssl/cert.key

[Install]
WantedBy=multi-user.target
