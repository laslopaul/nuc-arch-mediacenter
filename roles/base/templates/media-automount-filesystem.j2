# {{ ansible_managed }}
AUTOMOUNT_OPTS='users,nosuid,nodev,relatime,uid={{ managed_user_uid }},gid={{ managed_user_gid }},dmask=022,fmask=133'
AUTOMOUNT_TYPE='{{ item }}'
{% if item == 'ntfs' %}
if command -v ntfs-3g >/dev/null 2>&1; then
    AUTOMOUNT_TYPE='ntfs-3g'
else
    AUTOMOUNT_TYPE='ntfs3'
fi
{% endif %}
