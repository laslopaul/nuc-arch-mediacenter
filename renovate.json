{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ansible-galaxy": {
    "enabled": true,
    "managerFilePatterns": [
      "/^requirements\\.yml$/"
    ]
  },
  "pip_requirements": {
    "enabled": true,
    "managerFilePatterns": [
      "/^requirements-dev\\.txt$/"
    ]
  },
  "customManagers": [
    {
      "description": "Handle Docker images in Ansible var files",
      "datasourceTemplate": "docker",
      "customType": "regex",
      "managerFilePatterns": [
        "/roles/docker/defaults/main.yml/"
      ],
      "matchStrings": [
        "  [a-zA-Z0-9_-]+:\\s+\"(?<depName>[^:\"]+)(?::(?<currentValue>[^\"]+))?\""
      ],
      "packageNameTemplate": "{{depName}}"
    }
  ],
  "packageRules": [
    {
      "description": "Group Python dependency updates separately from Ansible collections",
      "matchManagers": ["pip_requirements"],
      "matchFileNames": ["requirements-dev.txt"],
      "groupName": "Python dependencies",
      "groupSlug": "python-dependencies",
      "separateMajorMinor": false
    },
    {
      "description": "Group Ansible collection updates in their own PR",
      "matchManagers": ["ansible-galaxy"],
      "matchFileNames": ["requirements.yml"],
      "groupName": "Ansible collections",
      "groupSlug": "ansible-collections",
      "separateMajorMinor": false
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    }
  ]
}
