services:
  qbittorrent:
    image: {{ images['qbittorrent'] }}
    container_name: qbittorrent
    environment:
      - PUID={{ managed_user_uid }}
      - PGID={{ managed_user_gid }}
      - WEBUI_PORT=8080
      - TZ={{ timezone }}
    volumes:
      - {{ docker_path }}/{{ docker_service_catalog['qbittorrent'].directory }}/config:/config
      - {{ media_path }}:/downloads
    ports:
      - "6881:6881"
      - "6881:6881/udp"
    restart: unless-stopped
    networks:
      - traefik_traefik
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.qb.rule=Host(`qb.{{ domain }}`) || Host(`qb.{{ public_domain }}`)"
      - "traefik.http.routers.qb.entrypoints=websecure"
      - "traefik.http.routers.qb.tls=true"
      - "traefik.http.services.qb.loadbalancer.server.port=8080"

networks:
  traefik_traefik:
    external: true
