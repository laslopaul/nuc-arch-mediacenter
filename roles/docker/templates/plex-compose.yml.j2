services:
  plex:
    image: {{ images['plex'] }}
    container_name: plex
    network_mode: host
    environment:
      - PUID={{ managed_user_uid }}
      - PGID={{ managed_user_gid }}
      - TZ={{ timezone }}
      - VERSION=docker
    volumes:
      - {{ docker_path }}/{{ docker_service_catalog['plex'].directory }}/config:/config
      - {{ media_path }}/Shows:/tv
      - {{ media_path }}/Movies:/movies
    devices:
      - /dev/dri:/dev/dri
    restart: unless-stopped
